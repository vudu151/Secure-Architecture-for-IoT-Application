# =============================================================================
# Smart Parking System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# WARNING: Never commit the .env file to version control!
# =============================================================================

# --- General ---
TIMEZONE=Asia/Ho_Chi_Minh

# --- PostgreSQL ---
POSTGRES_DB=smartparking
POSTGRES_USER=smartparking
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_PORT=6379

# --- Spring Boot Backend ---
SPRING_PROFILES_ACTIVE=prod
MAVEN_PROFILE=prod

# --- JWT Authentication ---
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# --- AES-256 Encryption Key ---
# Generate with: openssl rand -hex 32
AES_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- MQTT ---
MQTT_BACKEND_CLIENT_ID=smartparking-backend

# --- Application Security ---
APP_NONCE_MAX_AGE_SECONDS=5
APP_CORS_ALLOWED_ORIGINS=https://localhost,https://your-domain.com

# --- Nginx SSL (for generate_ssl.sh) ---
SSL_DOMAIN=localhost
SSL_COUNTRY=VN
SSL_STATE=Hanoi
SSL_CITY=Hanoi
SSL_ORG=SmartParking
SSL_UNIT=Engineering
