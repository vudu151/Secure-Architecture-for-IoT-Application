    },
    {
        "id": "fn-handle-response",
        "type": "function",
        "z": "tab-parking",
        "name": "Handle Response",
        "func": "var resp = msg.payload;\nif (msg.statusCode !== 200 || (resp && resp.success === false)) {\n    var err = (resp && resp.message) ? resp.message : 'API Request Failed';\n    var toastMsg = { payload: err, topic: 'Scan Error' };\n    var statusMsg = { payload: 'FAILED: ' + err };\n    return [toastMsg, statusMsg];\n}\nreturn [null, null];",
        "outputs": 2,
        "x": 790,
        "y": 100,
        "wires": [
