        "id": "http-request",
        "type": "http request",
        "z": "tab-parking",
        "name": "POST /scan",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
