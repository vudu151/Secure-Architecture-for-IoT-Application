    {
        "id": "ui-gate-status",
        "type": "ui_template",
        "z": "tab-parking",
        "group": "grp-gate",
        "name": "Gate Animation",
        "order": 1,
        "width": 12,
        "height": 5,
        "format": "<div class=\"gate-container\">\n    <div class=\"gate-status-text\">\n        Gate Status: <span id=\"gate-text\" style=\"font-weight: bold; color: #f44336;\">CLOSED</span>\n    </div>\n    <div class=\"barrier-wrapper\">\n        <div id=\"car-element\" class=\"car-element\">\ud83d\ude97</div>\n        <div class=\"barrier-base\"></div>\n        <div id=\"barrier-arm\" class=\"barrier-arm closed\">\n            <div class=\"stripe\"></div><div class=\"stripe\"></div><div class=\"stripe\"></div>\n            <div class=\"stripe\"></div><div class=\"stripe\"></div><div class=\"stripe\"></div>\n            <div class=\"stripe\"></div><div class=\"stripe\"></div><div class=\"stripe\"></div>\n        </div>\n    </div>\n</div>\n\n<style>\n.gate-container {\n    padding: 20px;\n    background: #f9f9f9;\n    border-radius: 8px;\n    text-align: center;\n    overflow: hidden;\n    height: 100%;\n    box-sizing: border-box;\n}\n.gate-status-text {\n    font-size: 18px;\n    margin-bottom: 20px;\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.barrier-wrapper {\n    position: relative;\n    height: 140px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n}\n.barrier-base {\n    width: 30px;\n    height: 60px;\n    background-color: #555;\n    border-radius: 4px 4px 0 0;\n    position: absolute;\n    bottom: 0;\n    left: calc(50% - 100px);\n    z-index: 2;\n    box-shadow: inset 2px 2px 5px rgba(255,255,255,0.2), 2px 0 5px rgba(0,0,0,0.5);\n}\n.barrier-arm {\n    width: 250px;\n    height: 18px;\n    background-color: #f44336;\n    position: absolute;\n    bottom: 45px;\n    left: calc(50% - 100px);\n    transform-origin: 15px 9px;\n    border-radius: 0 8px 8px 0;\n    transition: transform 1.5s ease-in-out, background-color 0.5s;\n    display: flex;\n    overflow: hidden;\n    z-index: 1;\n    box-shadow: 0 4px 6px rgba(0,0,0,0.3);\n}\n.barrier-arm.open {\n    transform: rotate(-90deg);\n    background-color: #4CAF50;\n}\n.barrier-arm.closed {\n    transform: rotate(0deg);\n    background-color: #f44336;\n}\n.stripe {\n    min-width: 25px;\n    height: 100%;\n    background-color: #fff;\n    transform: skewX(-45deg);\n    margin-left: 15px;\n}\n.car-element {\n    position: absolute;\n    bottom: 15px;\n    left: -80px;\n    font-size: 50px;\n    z-index: 0;\n    opacity: 0;\n    transform: scaleX(-1);\n}\n</style>\n\n<script>\n(function(scope) {\n    // Initial car approach on load\n    setTimeout(function() {\n        var car = document.getElementById(\"car-element\");\n        if (car) {\n            car.style.transition = 'transform 1.5s ease-out';\n            car.style.transform = 'translateX(180px) scaleX(-1)';\n            car.style.opacity = '1';\n        }\n    }, 500);\n\n    scope.$watch('msg', function(msg) {\n        if (!msg) return;\n        var cmd = msg.payload;\n        if (typeof cmd === 'object') { cmd = JSON.stringify(cmd); }\n        \n        var arm = document.getElementById(\"barrier-arm\");\n        var text = document.getElementById(\"gate-text\");\n        var car = document.getElementById(\"car-element\");\n        if (!arm || !text) return;\n        \n        if (cmd === \"\") {\n            // Reset logic if needed, but car is already waiting.\n            // We can just ensure it is at the gate.\n            if (car) {\n                car.style.transition = 'transform 0.5s ease-out';\n                car.style.transform = 'translateX(180px) scaleX(-1)';\n                car.style.opacity = '1';\n            }\n        } else if (cmd && (cmd.includes('open_gate') || cmd.includes('SUCCESS'))) {\n            arm.classList.remove(\"closed\");\n            arm.classList.add(\"open\");\n            text.innerText = \"OPEN\";\n            text.style.color = \"#4CAF50\";\n            \n            if (car) {\n                // Continue driving through\n                car.style.transition = 'transform 1.5s ease-in 0.5s, opacity 0.5s ease 1.5s';\n                car.style.transform = 'translateX(500px) scaleX(-1)';\n                car.style.opacity = '0';\n            }\n            \n            // Automatically close after 3 seconds\n            setTimeout(function() {\n                arm.classList.remove(\"open\");\n                arm.classList.add(\"closed\");\n                text.innerText = \"CLOSED\";\n                text.style.color = \"#f44336\";\n                \n                // Bring the next car after gate closes\n                setTimeout(function() {\n                    if (car) {\n                        car.style.transition = 'none';\n                        car.style.transform = 'translateX(0) scaleX(-1)';\n                        car.style.opacity = '1';\n                        void car.offsetWidth; // force reflow\n                        \n                        car.style.transition = 'transform 1.5s ease-out';\n                        car.style.transform = 'translateX(180px) scaleX(-1)';\n                    }\n                }, 500);\n            }, 3000);\n        } else if (cmd && cmd.includes('FAILED')) {\n            if (car) {\n                // Drive away backwards if failed\n                car.style.transition = 'transform 2s ease-in, opacity 1s ease 1s';\n                car.style.transform = 'translateX(-50px) scaleX(-1)';\n                car.style.opacity = '0';\n                \n                // Bring the next car\n                setTimeout(function() {\n                    if (car) {\n                        car.style.transition = 'none';\n                        car.style.transform = 'translateX(0) scaleX(-1)';\n                        car.style.opacity = '1';\n                        void car.offsetWidth;\n                        \n                        car.style.transition = 'transform 1.5s ease-out';\n                        car.style.transform = 'translateX(180px) scaleX(-1)';\n                    }\n                }, 3000);\n            }\n        }\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
