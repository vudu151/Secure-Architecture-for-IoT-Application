    {
        "id": "fn-parse-event",
        "type": "function",
        "z": "tab-parking",
        "name": "Parse Plate Event",
        "func": "var data = msg.payload;\nflow.set('lastPlate', data.plate || 'N/A');\nflow.set('lastConfidence', (data.confidence * 100).toFixed(0) + '%');\n\nvar ts = data.timestamp || '';\nif (ts) {\n    try {\n        var d = new Date(ts);\n        ts = d.toLocaleString('en-GB', { timeZone: 'Asia/Ho_Chi_Minh' });\n    } catch(e) {}\n}\n\nflow.set('lastTimestamp', ts);\nflow.set('lastImageUrl', data.image_url || '');\n\nvar out1 = { payload: data.plate || 'N/A' };\nvar out2 = { payload: (data.confidence * 100).toFixed(0) + '%' };\nvar out3 = { payload: ts };\nvar out4 = { payload: 'SUCCESS' };\n\nreturn [out1, out2, out3, out4];",
        "outputs": 4,
        "x": 380,
        "y": 250,
        "wires": [
            [
                "ui-plate-text"
            ],
            [
                "ui-confidence-text"
            ],
            [
                "ui-timestamp-text"
            ],
            [
                "ui-status-text",
                "ui-gate-status"
            ]
        ]
    },
    {
        "id": "fn-parse-gate",
        "type": "function",
        "z": "tab-parking",
        "name": "Parse Gate Command",
        "func": "var raw = msg.payload;\nif (typeof raw === 'string') {\n    msg.payload = raw;\n} else {\n    msg.payload = JSON.stringify(raw);\n}\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 350,
