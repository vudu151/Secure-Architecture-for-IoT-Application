    {
        "id": "fn-build-multipart",
        "type": "function",
        "z": "tab-parking",
        "name": "Build Multipart Form",
        "func": "var p = msg.payload;\nvar formData = {};\n\nif (p.qr_data && p.qr_data.trim() !== '') {\n    formData.qr_data = p.qr_data;\n}\n\nif (p.qr_image) {\n    formData.qr_image = {\n        value: Buffer.from(p.qr_image.data.split(',')[1], 'base64'),\n        options: {\n            filename: p.qr_image.filename,\n            contentType: p.qr_image.mimetype\n        }\n    };\n}\n\nif (p.camera_image) {\n    formData.camera_image = {\n        value: Buffer.from(p.camera_image.data.split(',')[1], 'base64'),\n        options: {\n            filename: p.camera_image.filename,\n            contentType: p.camera_image.mimetype\n        }\n    };\n}\n\nmsg.payload = formData;\nmsg.headers = {\n    \"content-type\": \"multipart/form-data\"\n};\nmsg.url = 'http://qr-scanner:8001/scan';\nmsg.method = 'POST';\n\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 100,
        "wires": [
