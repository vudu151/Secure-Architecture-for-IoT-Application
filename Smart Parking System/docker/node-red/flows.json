    {
        "id": "ui-upload-form",
        "type": "ui_template",
        "z": "tab-parking",
        "group": "grp-trigger",
        "name": "Upload Form",
        "order": 1,
        "width": 5,
        "height": 8,
        "format": "<style>\n  .modern-form {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      padding: 10px;\n  }\n  .modern-form label {\n      display: block;\n      margin-bottom: 6px;\n      font-weight: 600;\n      color: #333;\n  }\n  .modern-form input[type=\"text\"],\n  .modern-form input[type=\"file\"] {\n      width: 100%;\n      box-sizing: border-box;\n      padding: 10px;\n      margin-bottom: 15px;\n      border: 1px solid #ccc;\n      border-radius: 6px;\n      background: #fff;\n      font-family: inherit;\n  }\n  .modern-form input[type=\"text\"]:focus {\n      border-color: #2196F3;\n      outline: none;\n      box-shadow: 0 0 4px rgba(33,150,243,0.3);\n  }\n  .modern-form button {\n      width: 100%;\n      background-color: #2196F3;\n      color: white;\n      padding: 12px;\n      border: none;\n      border-radius: 6px;\n      font-weight: bold;\n      font-size: 14px;\n      cursor: pointer;\n      transition: background-color 0.2s, transform 0.1s;\n      box-shadow: 0 2px 4px rgba(33,150,243,0.3);\n  }\n  .modern-form button:hover {\n      background-color: #1976D2;\n  }\n  .modern-form button:active {\n      transform: scale(0.98);\n  }\n</style>\n\n<div class=\"modern-form\">\n    <label>QR Code (Text Input):</label>\n    <input type=\"text\" id=\"qrDataInput\" placeholder=\"e.g.: 1234567890\">\n    \n    <label>Or Upload QR Image:</label>\n    <input type=\"file\" id=\"qrImageInput\" accept=\"image/*\">\n\n    <button id=\"submitBtn\">\n        SUBMIT FOR SCANNING\n    </button>\n\n</div>\n\n<script>\n(function(scope) {\n    var qrDataInput = document.getElementById(\"qrDataInput\");\n    var qrImageInput = document.getElementById(\"qrImageInput\");\n\n    function compressImage(file, callback) {\n        var reader = new FileReader();\n        reader.onload = function(e) {\n            var img = new Image();\n            img.onload = function() {\n                var canvas = document.createElement('canvas');\n                var ctx = canvas.getContext('2d');\n                var MAX_SIZE = 2000;\n                var width = img.width;\n                var height = img.height;\n                \n                if (width > height) {\n                    if (width > MAX_SIZE) {\n                        height *= MAX_SIZE / width;\n                        width = MAX_SIZE;\n                    }\n                } else {\n                    if (height > MAX_SIZE) {\n                        width *= MAX_SIZE / height;\n                        height = MAX_SIZE;\n                    }\n                }\n                \n                canvas.width = width;\n                canvas.height = height;\n                ctx.drawImage(img, 0, 0, width, height);\n                \n                var dataUrl = canvas.toDataURL('image/jpeg', 0.95);\n                callback(dataUrl);\n            };\n            img.src = e.target.result;\n        };\n        reader.readAsDataURL(file);\n    }\n\n    function executeSend(qrData, qrFile, btn, originalText, btnOriginalColor) {\n        var payloadData = {\n            qr_data: qrData\n        };\n\n        var readPromises = [];\n\n        if (qrFile) {\n            readPromises.push(new Promise((resolve) => {\n                compressImage(qrFile, function(dataUrl) {\n                    payloadData.qr_image = {\n                        data: dataUrl,\n                        filename: qrFile.name,\n                        mimetype: 'image/jpeg'\n                    };\n                    resolve();\n                });\n            }));\n        }\n\n        Promise.all(readPromises).then(() => {\n            scope.send([ { payload: payloadData }, { payload: \"\" } ]);\n            setTimeout(() => {\n                btn.innerText = originalText;\n                btn.style.backgroundColor = btnOriginalColor;\n            }, 2000);\n        });\n    }\n\n    function submitForm(btnId) {\n        var qrData = qrDataInput.value;\n        var qrFile = qrImageInput.files[0];\n        \n        var btn = document.getElementById(btnId);\n        var originalText = btn.innerText;\n        var btnOriginalColor = btn.style.backgroundColor;\n        \n        var globalCam = document.getElementById('globalLiveCam');\n        var camPlaceholder = document.getElementById('camPlaceholder');\n        var camUrlInput = document.getElementById('cameraSourceUrl');\n        var camCounter = document.getElementById('camCounter');\n        var camUrl = camUrlInput ? camUrlInput.value : \"\";\n\n        if (globalCam && camPlaceholder) {\n            // Enable Camera View\n            globalCam.src = camUrl;\n            globalCam.style.display = 'block';\n            camPlaceholder.style.display = 'none';\n            \n            var count = 5;\n            if (camCounter) {\n                // Reset styles\n                camCounter.style.fontSize = \"80px\";\n                camCounter.style.color = \"white\";\n                camCounter.innerText = count;\n                camCounter.style.display = 'block';\n            }\n            btn.innerText = \"CAPTURING IN \" + count + \"...\";\n            btn.style.backgroundColor = \"#9e9e9e\";\n            \n            var interval = setInterval(function() {\n                count--;\n                if (count >= 1) {\n                    btn.innerText = \"CAPTURING IN \" + count + \"...\";\n                    if (camCounter) {\n                        camCounter.innerText = count;\n                        if (count === 1) {\n                            camCounter.style.color = \"#ffeb3b\"; // Yellow right before capturing\n                        }\n                    }\n                } else {\n                    // Count reached 0 -> capture time\n                    clearInterval(interval);\n                    btn.innerText = \"SENDING...\";\n                    if (camCounter) {\n                        camCounter.innerText = \"CAPTURED!\";\n                        camCounter.style.fontSize = \"50px\";\n                        camCounter.style.color = \"#4CAF50\";\n                    }\n                    \n                    // Capture and Send\n                    executeSend(qrData, qrFile, btn, originalText, btnOriginalColor);\n                    \n                    // Wait 5 more seconds before turning off screen\n                    setTimeout(function() {\n                        globalCam.src = \"\";\n                        globalCam.style.display = 'none';\n                        camPlaceholder.style.display = 'block';\n                        if (camCounter) {\n                            camCounter.style.display = 'none';\n                        }\n                    }, 5000);\n                }\n            }, 1000);\n        } else {\n            btn.innerText = \"SENDING...\";\n            btn.style.backgroundColor = \"#9e9e9e\";\n            executeSend(qrData, qrFile, btn, originalText, btnOriginalColor);\n        }\n    }\n\n    document.getElementById(\"submitBtn\").addEventListener(\"click\", function() {\n        submitForm(\"submitBtn\");\n    });\n\n\n})(scope);\n</script>",
