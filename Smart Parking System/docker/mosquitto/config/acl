# =============================================================================
# Mosquitto ACL (Access Control List)
# Smart Parking System
# =============================================================================
# Username source:
#   - Port 1883: anonymous (no username) → matches anonymous ACL
#   - Port 8883: certificate CN via use_identity_as_username
#
# Topic Structure:
#   parking/slots/{slot_id}/status     - ESP32 publishes occupancy status
#   parking/slots/{slot_id}/command    - Backend sends LED commands to ESP32
#   parking/gates/{gate_id}/event      - RPi publishes gate events (plate, QR)
#   parking/gates/{gate_id}/control    - Backend sends open/close to RPi
#   parking/devices/{device_id}/heartbeat - All devices publish heartbeats
# =============================================================================

# ---------------------------------------------------------------------------
# Anonymous access (Port 1883 - Backend service within Docker network)
# ---------------------------------------------------------------------------
# Backend has full read/write access to all topics
topic readwrite #
topic read $SYS/#
# ---------------------------------------------------------------------------
# ESP32 Devices - Zone A (Slots A01-A10)
# ---------------------------------------------------------------------------
# Each ESP32 can only write to its own slot status topic
# and read commands for its own slot.

user esp32_slot_a01
topic write parking/slots/a01/status
topic read parking/slots/a01/command
topic write parking/devices/esp32_slot_a01/heartbeat

